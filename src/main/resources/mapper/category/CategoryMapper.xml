<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.chokokane.mapper.category.CategoryMapper">
    <resultMap
        id="categoryResultMap"
        type="com.example.chokokane.model.category.Category"
    >
        <constructor>
            <idArg column="id" javaType="java.lang.Long" />
            <arg column="user_id" javaType="java.lang.Long" />
            <arg column="name" javaType="java.lang.String" />
            <arg column="color" javaType="java.lang.String" />
            <arg column="is_system" javaType="_boolean" />
            <arg column="created_at" javaType="java.time.LocalDateTime" />
            <arg column="deleted_at" javaType="java.time.LocalDateTime" />
        </constructor>
    </resultMap>
    <select
        id="findActiveByUserId"
        resultMap="categoryResultMap"
    >
        SELECT *
        FROM categories
        WHERE user_id = #{userId}
        AND deleted_at IS NULL
        ORDER BY id ASC
    </select>
</mapper>