<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

    <mapper namespace="com.example.chokokane.mapper.user.UserMapper">
        <resultMap
          id="userResultMap"
          type="com.example.chokokane.model.user.User"
        >
            <id column="id" property="id" />
            <result column="name" property="name" />
            <result column="email" property="email" />
            <result column="password" property="password" />
        </resultMap>

        <insert
            id="save"
            useGeneratedKeys="true"
            keyProperty="user.id"
        >
            INSERT INTO users (
                name,
                email,
                password
            )
            VALUES (
                #{user.name},
                #{user.email},
                #{user.password}
            )
        </insert>

        <select
            id="findByEmail"
            resultMap="userResultMap"
        >
            SELECT id, name, email, password
            FROM users
            WHERE email = #{email}
        </select>

        <select
            id="findById"
            resultMap="userResultMap"
        >
            SELECT id, name, email, password
            FROM users
            WHERE id = #{userId}
        </select>

        <select
            id="deleteMe"
            resultType="int"
        >
            DELETE FROM users
            WHERE id = #{userId}
        </select>
    </mapper>