<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

    <mapper namespace="com.example.chokokane.mapper.auth.PasswordResetTokenMapper">

        <resultMap
            id="passwordResetTokenResultMap"
            type="com.example.chokokane.model.auth.PasswordResetToken"
        >
            <constructor>
                <idArg column="id" javaType="java.lang.Long" />
                <arg column="user_id" javaType="java.lang.Long" />
                <arg column="token_hash" javaType="java.lang.String" />
                <arg column="created_at" javaType="java.time.LocalDateTime" />
                <arg column="expires_at" javaType="java.time.LocalDateTime" />
                <arg column="used_at" javaType="java.time.LocalDateTime" />
            </constructor>
        </resultMap>

        <select id="findByTokenHash" resultMap="passwordResetTokenResultMap">
            SELECT id, user_id, token_hash, created_at, expires_at, used_at
            FROM password_reset_tokens
            WHERE token_hash = #{tokenHash}
        </select>

        <insert id="upsert">
            INSERT INTO password_reset_tokens (
                user_id,
                token_hash,
                created_at,
                expires_at,
                used_at
            )
            VALUES (
                #{token.userId},
                #{token.tokenHash},
                #{token.createdAt},
                #{token.expiresAt},
                NULL
            )
            ON DUPLICATE KEY UPDATE
                token_hash = #{token.tokenHash},
                created_at = #{token.createdAt},
                expires_at = #{token.expiresAt},
                used_at = NULL
        </insert>

        <update id="markUsed">
            UPDATE password_reset_tokens
            SET used_at = #{now}
            WHERE token_hash = #{tokenHash}
                AND used_at IS NULL
                AND expires_at > #{now}
        </update>

        <delete id="deleteByUserId">
            DELETE FROM password_reset_tokens
            WHERE user_id = #{userId}
        </delete>
    </mapper>